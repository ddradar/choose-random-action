{
  "name": "choose-random-action",
  "version": "4.1.0",
  "private": true,
  "description": "Choose one randomly from multiple user inputs",
  "keywords": [
    "actions",
    "github-actions",
    "random"
  ],
  "license": "MIT",
  "author": "Nogic <24802730+nogic1008@users.noreply.github.com>",
  "repository": "https://github.com/ddradar/choose-random-action",
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "node --experimental-strip-types build.mts",
    "fix": "run-p fix:*",
    "fix:oxlint": "oxlint --type-aware --fix",
    "fix:oxfmt": "oxfmt",
    "lint": "run-p lint:*",
    "lint:oxlint": "oxlint --type-aware",
    "lint:oxfmt": "oxfmt --check",
    "prepare": "husky",
    "test": "node --test --experimental-strip-types --experimental-test-module-mocks"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.13.3",
    "cobertura": "^1.0.3",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,ts,mts}": [
      "oxlint --type-aware --fix",
      "oxfmt"
    ],
    "*.{json,md,yml}": "oxfmt"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.2+sha512.b885e890b9418fa1693544d05f53e64f9a73ec194837d4258b15fecdd692347b1dd2a517b1b0cbaf9d31cd8e92c3b70956bd2ecc72833a57b4b3098f5bfa7943",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
