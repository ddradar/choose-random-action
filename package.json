{
  "name": "choose-random-action",
  "version": "4.1.0",
  "private": true,
  "description": "Choose one randomly from multiple user inputs",
  "keywords": [
    "actions",
    "github-actions",
    "random"
  ],
  "license": "MIT",
  "author": "Nogic <24802730+nogic1008@users.noreply.github.com>",
  "repository": "https://github.com/ddradar/choose-random-action",
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "node --experimental-strip-types build.mts",
    "fix": "run-p fix:*",
    "fix:oxlint": "oxlint --fix",
    "fix:oxfmt": "oxfmt",
    "lint": "run-p lint:*",
    "lint:oxlint": "oxlint",
    "lint:oxfmt": "oxfmt --check",
    "prepare": "husky",
    "test": "node --test --experimental-strip-types --experimental-test-module-mocks"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.19.0",
    "cobertura": "^1.0.3",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,ts,mts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,yml}": "oxfmt"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.1.0+sha512.17286eeb6a4dc7bd180acff9f9d1262504c556648ac2fa39080d2abc19060d1a686f8d8c27a1b6450dad77178a3389d89c8643aa4600c4482ab687a39fd406b5",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
